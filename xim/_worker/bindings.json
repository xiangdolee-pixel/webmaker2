{
  "placement": { "region": "aws:ap-northeast-2" },
  "version_metadata": { "binding": "VER" },
  "assets": { "run_worker_first": ["/", "/index.html", "/js/*", "/css/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "xim", "database_id": "a0f671ad-6602-46bf-8e76-043cdbdf250d" },
    { "binding": "XMS_DB", "database_name": "xms", "database_id": "0fd9af7c-f214-4fee-80bb-1e8b94099bda" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "xms-files" }
  ],
  "services": [
    { "binding": "CLONE", "service": "clone" }
  ],
  "workflows": [
    { "name": "xim-studio", "binding": "STUDIO_WF", "class_name": "StudioMain" }
  ]
}
